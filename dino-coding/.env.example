# ==============================================================================
# DINO CODING AGENT — CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# ==============================================================================
# Hướng dẫn:
# 1. Copy file này thành .env:  cp .env.example .env
# 2. Chọn AI_PROVIDER tương ứng và điền API Key của bạn.
# ------------------------------------------------------------------------------

# Lựa chọn provider: openai | anthropic | gemini | openrouter | deepseek | zai | siliconflow
AI_PROVIDER=openai

# ==============================================================================
# 1. OPENAI (Chính thức)
# ==============================================================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# 2. ANTHROPIC (Claude chính thức)
# Lưu ý: Nếu dùng trực tiếp, cần cài thêm package: uv add langchain-anthropic
# ==============================================================================
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ==============================================================================
# 3. GOOGLE GEMINI (Google AI Studio)
# Chạy qua endpoint chuẩn OpenAI-compatible (không cần cài thêm package)
# ==============================================================================
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ==============================================================================
# 4. OPENROUTER (Gateway đa mô hình: Claude, DeepSeek, Llama, Gemini...)
# ==============================================================================
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=anthropic/claude-3.7-sonnet
# OPENROUTER_MODEL=deepseek/deepseek-r1
# OPENROUTER_MODEL=google/gemini-2.5-pro

# ==============================================================================
# 5. DEEPSEEK (API chính thức: platform.deepseek.com)
# ==============================================================================
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL=deepseek-reasoner

# ==============================================================================
# 6. Z.AI (Zhipu AI / GLM Global Endpoint cho tài khoản quốc tế)
# Base URL chuẩn quốc tế: https://api.z.ai/api/paas/v4
# ==============================================================================
# AI_PROVIDER=zai
# ZAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_MODEL=glm-4-plus
# ZAI_MODEL=glm-4-flash
# (Nếu dùng gói GLM Coding Plan: ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4)

# ==============================================================================
# 7. SILICONFLOW (Hạ tầng DeepSeek V3 / R1 tốc độ cao tại Châu Á)
# ==============================================================================
# AI_PROVIDER=siliconflow
# SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-R1